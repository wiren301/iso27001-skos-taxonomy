      {
        "@language": "en",
        "@value": "Zone by trust."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Segregation of networks"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Trust boundaries."
      }
    ]
  },
