    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Restrict browsing."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.23"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Web filtering techniques include: heuristics, signature matching, allowlisting and blocklisting, configuring domain name services to block malicious domains, configuring endpoints to check URLs with a web filtering service on the Internet, implementing a proxy to filter access to websites based on URL or content, configuring browsers to use safe web browsing lists which are lists that block malicious sites."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
