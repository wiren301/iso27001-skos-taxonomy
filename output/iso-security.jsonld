  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.22",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Segment networks."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.22"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Networks can extend beyond organizational premises due to partnerships requiring interconnection or sharing of information processing and networking facilities. Such extensions can increase the risk of unauthorized access to the organization's existing information systems that use the network, some of which require protection from other network users because of their sensitivity or criticality."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
