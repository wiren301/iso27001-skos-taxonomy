    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "NOTE: Top management can also assign responsibilities and authorities for reporting performance of the information security management system within the organization."
      }
    ]
  },
