    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Address vendor dangers."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.19"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "When not properly managed, information security risks associated with suppliers can lead to compromises of information and other associated assets of the organization. Suppliers include service providers."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
