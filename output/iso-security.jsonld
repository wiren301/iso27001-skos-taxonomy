  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/5.29",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Preserve safety through crises."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.29"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Business continuity plans or disaster recovery plans can contain information security requirements that can be useful to meet this control. Information to support this can be found in ISO 22301 and ISO 22313."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "5.29"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Plan ahead."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Information security during disruption"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Crisis protection."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/5.1",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Executives champion the framework."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "5.1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "a) ensuring the information security policy and the information security objectives are established and are compatible with the strategic direction of the organization;\nb) ensuring the integration of the information security management system requirements into the organization's processes;\nc) ensuring that the resources needed for the information security management system are available;\nd) communicating the importance of effective information security management and of conforming to the information security management system requirements;\ne) ensuring that the information security management system achieves its intended outcome(s);\nf) directing and supporting persons to contribute to the effectiveness of the information security management system;\ng) promoting continual improvement; and\nh) supporting other relevant management roles to demonstrate their leadership as it applies to their areas of responsibility."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Leadership and commitment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "NOTE: Reference to \"business\" in this document can be interpreted broadly to mean those activities that are core to the purposes of the organization's existence."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/term/3.6",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "genuineness confirmation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/VocabularyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "3.6"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "authenticity"
      },
      {
        "@language": "en",
        "@value": "review objective"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.31",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Wall off build phases."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.31"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Development and testing activities can cause serious problems, e.g. unwanted modification of files or system environment, or system failure. A known level of separation between production, testing and development environments is necessary to reduce the risk of accidental change or unauthorized access to operational software and business data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "8.31"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Limit transfers."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Separation of development, test and production environments"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Shield production."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/9.1",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/9"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Define tracking metrics."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "9.1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "a) what needs to be monitored and measured, including information security processes and controls;\nb) the methods for monitoring, measurement, analysis and evaluation, as applicable, to ensure valid results. The methods selected should produce comparable and reproducible results to be considered valid;\nc) when the monitoring and measuring shall be performed;\nd) who shall monitor and measure;\ne) when the results from monitoring and measurement shall be analysed and evaluated;\nf) who shall analyse and evaluate these results.\n\nThe organization shall evaluate the information security performance and the effectiveness of the information security management system."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Monitoring, measurement, analysis and evaluation"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.33",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Curate test data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.33"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "System and acceptance testing can require substantial volumes of test information that are as close as possible to operational information. The use of operational databases containing PII or any other confidential information for testing should be avoided."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "8.33"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Prefer synthetic data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Test information"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Ensure relevance and protection."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.14",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Govern data movement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/5.14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/AnnexAScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "A.5.14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Information transfer"
      }
    ]
  },
