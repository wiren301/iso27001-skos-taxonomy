      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/6.6",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Formalize secrecy pledges."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.6.6"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Confidentiality or non-disclosure agreements can serve to protect organizational information and inform signatories of their responsibility to protect, use and disclose information in a responsible and authorized manner."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "6.6"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Use enforceable terms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Confidentiality or non-disclosure agreements"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Sustain confidentiality."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.32",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Govern modifications."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.32"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "System changes affect applications, databases, operating systems, network devices, and their configuration. Inadequately controlled changes are a common cause of security and operational incidents. Changes to production systems should be kept to a minimum. Non-essential changes should be delayed until a change window or downtime period."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "8.32"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Test changes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Change management"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Change safety."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.4",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
