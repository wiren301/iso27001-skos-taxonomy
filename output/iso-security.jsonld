      {
        "@value": "5.3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Top management shall assign the responsibility and authority for:\na) ensuring that the information security management system conforms to the requirements of this document;\nb) reporting on the performance of the information security management system to top management."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
