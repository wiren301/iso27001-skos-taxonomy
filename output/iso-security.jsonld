      {
        "@language": "en",
        "@value": "Use multiple sources."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Management of technical vulnerabilities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Block exploitation."
      }
    ]
  },
