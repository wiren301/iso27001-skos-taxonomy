        "@language": "en",
        "@value": "Support"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/5.28",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Standardize forensics."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.28"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "When an information security event is first detected, it is not always obvious whether or not the event will result in court action. Therefore, the danger exists that necessary evidence is destroyed intentionally or accidentally before the seriousness of the incident is realized. It is advisable to involve a lawyer or police early in any contemplated legal action and take advice on the evidence required. For further guidance on digital evidence see ISO/IEC 27037, ISO/IEC 27041, ISO/IEC 27042 and ISO/IEC 27043."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "5.28"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Cover all media types."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Collection of evidence"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Enable consistent evidence handling."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/7.13",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Maintain gear properly."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.7.13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "No other information."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "7.13"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Follow vendor guidance."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Equipment maintenance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Prevent maintenance harm."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/6.2",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/6"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Set protection targets."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "6.2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The information security objectives shall:\na) be consistent with the information security policy;\nb) be measurable (if practicable);\nc) take into account applicable information security requirements, and results from risk assessment and risk treatment;\nd) be monitored;\ne) be communicated;\nf) be updated as appropriate;\ng) be available as documented information.\n\nWhen planning how to achieve its information security objectives, the organization shall determine:\nh) what will be done;\ni) what resources will be required;\nj) who will be responsible;\nk) when it will be completed; and\nl) how the results will be evaluated."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Information security objectives and planning to achieve them"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#narrower": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5.1"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5.2"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5.3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "7.5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Documented information"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/term/3.16",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "flaw fix"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/VocabularyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "3.16"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "correction"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/9.3.3",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/9.3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Yield enhancement decisions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "9.3.3"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Management review results"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/5.5",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Cultivate oversight ties."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Organizations under attack can request authorities to take action against the attack source. Maintaining such contacts can be a requirement to support information security incident management (see 5.24 to 5.28) or the contingency planning and business continuity processes (see 5.29 and 5.30). Contacts with regulatory bodies are also useful to anticipate and prepare for upcoming changes in relevant laws or regulations that affect the organization. Contacts with other authorities include utilities, emergency services, electricity suppliers and health and safety [e.g. fire departments (in connection with business continuity), telecommunication providers (in connection with line routing and availability) and water suppliers (in connection with cooling facilities for equipment)]."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "5.5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Define protocols."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Contact with authorities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Enable information flow."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/term/3.24",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "accountability holders"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/VocabularyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "3.24"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "In certain contexts, this may be a board of directors."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "governing body"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.5",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Match verification to sensitivity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/AnnexAScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "A.8.5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Secure authentication"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.14",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Include backup capacity."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/AnnexAScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "A.8.14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Redundancy of information processing facilities"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-02-04"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Information Security Management System requirements organized by clause"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/1"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/2"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/3"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/4"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/5"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/6"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/8"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/9"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/10"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "ISO/IEC 27001:2022 ISMS Requirements"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/term/3.14",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "key concept"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27000/VocabularyScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "3.14"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Controls encompass processes, policies, devices, practices, and other risk-modifying actions. | It is possible that controls not always exert the intended or assumed modifying effect."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "control"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/6.2",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Document job terms."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.6.2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A code of conduct can be used to state personnel's information security responsibilities regarding confidentiality, PII protection, ethics, appropriate use of the organization's information and other associated assets, as well as reputable practices expected by the organization."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "6.2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Address confidentiality."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Terms and conditions of employment"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Ensure duty awareness."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.2",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Curb admin access."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Inappropriate allocation and use of system administration privileges can be a major contributory factor to the failure or breach of systems. See also 8.18 for privileged utility programs."
      },
      {
        "@language": "en",
        "@value": "Additional information on network security can be found in the ISO/IEC 27033 series. Further information on networks can be found in ISO/IEC TS 27034-6."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "8.2"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Log usage."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Privileged access rights"
      },
      {
        "@language": "en",
        "@value": "Networks security"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Limit privileged parties."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/5.24",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Pre-plan breach response."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.24"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Information security incidents can transcend organizational and national boundaries. To respond to such incidents, it is beneficial to coordinate response and share information about these incidents with external organizations as appropriate. Detailed guidance on information security incident management is provided in the ISO/IEC 27035 series."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "5.24"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Establish roles and duties."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Information security incident management planning and preparation"
      }
    ],
