      {
        "@language": "en",
        "@value": "Information security awareness, education and training"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Duty awareness."
      }
    ]
  },
