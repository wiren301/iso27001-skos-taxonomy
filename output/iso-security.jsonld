      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.11"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.12"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.33"
      },
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.34"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Operational Capability: Information_protection"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.5.32",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Shield IP assets."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/5.32"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/AnnexAScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "A.5.32"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Intellectual property rights"
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.15",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Capture event trails."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.15"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Event logs can contain sensitive data and PII. Appropriate privacy-protecting measures should be taken. Where possible, system administrators should not have permission to erase or deactivate logs of their own activities."
      }
    ],
