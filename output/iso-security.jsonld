    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Backup strategies can be enhanced by storage tiering techniques which automatically move data between storage media of different costs based on access frequency or age."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
