  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/control/8.16",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Watch for anomalies."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.8.16"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "The use of specialized, automated tools for monitoring activities is often necessary due to the amount of information typically generated, the criticality of timely reaction and the complexity of information systems and networks. Specialized tools such as EDR (endpoint detection and response), XDR (extended detection and response), SIEM (security information and event management) and UEBA (user and entity behaviour analytics) can support monitoring activities."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27002/ControlsScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "8.16"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Match scope to needs."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Monitoring activities"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Detect incidents."
      }
    ]
  },
