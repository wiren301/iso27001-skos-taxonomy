    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "6.8"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Provide easy access."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Information security event reporting"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Support timely alerts."
      }
    ]
  },
  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/control/A.7.14",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
