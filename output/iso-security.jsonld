  {
    "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5.1",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Include mandated records."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://wiren301.github.io/iso27001-skos-taxonomy/27001/ISMSScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "7.5.1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "a) documented information required by this document; and\nb) documented information determined by the organization as being necessary for the effectiveness of the information security management system."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "General"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "NOTE: The extent of documented information for an information security management system can differ from one organization to another due to:\n1) the size of organization and its type of activities, processes, products and services;\n2) the complexity of processes and their interactions; and\n3) the competence of persons."
      }
    ]
  },
