# CQ31: Total cross-references in vocabulary?
# Category G: Completeness Validation
# Expected: 98 related links

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT (COUNT(*) AS ?count)
WHERE {
  ?term skos:inScheme <https://wiren301.github.io/iso27001-skos-taxonomy/27000/VocabularyScheme> ;
        skos:related ?related .
}
