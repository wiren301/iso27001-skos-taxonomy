# CQ32: All controls have definitions?
# Category G: Completeness Validation
# Expected: 0 controls missing definitions

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT (COUNT(?control) AS ?missingDefinitions)
WHERE {
  ?control skos:inScheme <https://wiren301.github.io/iso27001-skos-taxonomy/27001/AnnexAScheme> .
  FILTER NOT EXISTS { ?control skos:definition ?def }
}
