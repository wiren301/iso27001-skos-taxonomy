# CQ06: What documentation is required?
# Category A: Requirement Retrieval
# Expected: Documented information requirements

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?definition ?note
WHERE {
  <https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5> skos:definition ?definition .
  OPTIONAL { <https://wiren301.github.io/iso27001-skos-taxonomy/27001/clause/7.5> skos:note ?note . }
}
