# CQ28: How many control pairs exist?
# Category F: Cross-Standard Tracing
# Expected: 93 exactMatch pairs

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT (COUNT(?link) AS ?count)
WHERE {
  ?control skos:inScheme <https://wiren301.github.io/iso27001-skos-taxonomy/27001/AnnexAScheme> ;
           skos:exactMatch ?link .
}
